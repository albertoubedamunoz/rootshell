<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<dictionary title="Rootshell Terminology">

	<suite name="Standard Suite" code="????" description="Common commands for most applications.">
		<command name="open" code="aevtodoc" description="Open a folder in a new local shell tab.">
			<cocoa class="RootshellOpenCommand"/>
			<direct-parameter description="The file or folder to open.">
				<type type="file" list="yes"/>
			</direct-parameter>
		</command>
	</suite>

	<suite name="Rootshell Suite" code="RTSH" description="Commands for opening terminals in Rootshell.">
		<command name="create tab" code="RTSHntab" description="Open a new tab in the front window. Runs a local shell unless a profile is given.">
			<cocoa class="RootshellCreateTabCommand"/>
			<parameter name="with command" code="rcmd" type="text" optional="yes" description="A command to run once the shell starts. The shell stays open afterwards.">
				<cocoa key="command"/>
			</parameter>
			<parameter name="in directory" code="rdir" type="text" optional="yes" description="Working directory for the shell. Accepts ~ and relative paths.">
				<cocoa key="directory"/>
			</parameter>
			<parameter name="using profile" code="rprf" type="text" optional="yes" description="Name of a connection profile to connect with instead of a local shell.">
				<cocoa key="profile"/>
			</parameter>
		</command>
		<command name="create window" code="RTSHnwin" description="Open a new window. Runs a local shell unless a profile is given.">
			<cocoa class="RootshellCreateWindowCommand"/>
			<parameter name="with command" code="rcmd" type="text" optional="yes" description="A command to run once the shell starts. The shell stays open afterwards.">
				<cocoa key="command"/>
			</parameter>
			<parameter name="in directory" code="rdir" type="text" optional="yes" description="Working directory for the shell. Accepts ~ and relative paths.">
				<cocoa key="directory"/>
			</parameter>
			<parameter name="using profile" code="rprf" type="text" optional="yes" description="Name of a connection profile to connect with instead of a local shell.">
				<cocoa key="profile"/>
			</parameter>
		</command>
		<command name="focus pane" code="RTSHfpan" description="Focus a terminal pane by its surface UUID (from LC_ROOTSHELL_PANE).">
			<cocoa class="RootshellFocusPaneCommand"/>
			<direct-parameter optional="yes" description="The surface UUID of the pane to focus.">
				<type type="text"/>
			</direct-parameter>
			<parameter name="with id" code="rpid" type="text" optional="yes" description="The surface UUID of the pane to focus.">
				<cocoa key="paneId"/>
			</parameter>
			<result type="boolean" description="True if the pane was found and focused."/>
		</command>
		<command name="current pane id" code="RTSHcpid" description="Get the surface UUID of the currently focused terminal pane.">
			<cocoa class="RootshellCurrentPaneIdCommand"/>
			<result type="text" description="The surface UUID of the focused terminal pane, or an empty string if none."/>
		</command>
		<command name="list pane ids" code="RTSHlpid" description="Get the surface UUIDs of all open terminal panes.">
			<cocoa class="RootshellListPaneIdsCommand"/>
			<result description="A list of surface UUIDs of all open terminal panes.">
				<type type="text" list="yes"/>
			</result>
		</command>
	</suite>

</dictionary>
