// Standalone.xcconfig - Settings for direct distribution (non-App Store)

// Sandbox DISABLED for Standalone
ENABLE_APP_SANDBOX = NO
ENABLE_HARDENED_RUNTIME = YES

// Standalone entitlements (platform-specific)
// iOS/iPadOS/visionOS: includes NFC for YubiKey PIV
// Mac Catalyst: excludes NFC (not supported on macOS)
CODE_SIGN_ENTITLEMENTS = rootshell/Entitlements/Standalone.entitlements
CODE_SIGN_ENTITLEMENTS[sdk=macosx*] = rootshell/Entitlements/Standalone-MacCatalyst.entitlements

// Shell commands may request permission to automate other macOS applications.
INFOPLIST_KEY_NSAppleEventsUsageDescription[sdk=macosx*] = Programs you run in rootshell may control other applications using Apple events.

// Allow programs launched from the standalone macOS terminal to request
// user-controlled access to the same protected resources as other terminals.
INFOPLIST_KEY_NSBluetoothAlwaysUsageDescription[sdk=macosx*] = Programs you run in rootshell may use Bluetooth.
INFOPLIST_KEY_NSCalendarsUsageDescription[sdk=macosx*] = Programs you run in rootshell may access your calendars.
INFOPLIST_KEY_NSCalendarsFullAccessUsageDescription[sdk=macosx*] = Programs you run in rootshell may read and modify your calendars.
INFOPLIST_KEY_NSCalendarsWriteOnlyAccessUsageDescription[sdk=macosx*] = Programs you run in rootshell may add events to your calendars.
INFOPLIST_KEY_NSContactsUsageDescription[sdk=macosx*] = Programs you run in rootshell may access your contacts.
INFOPLIST_KEY_NSPhotoLibraryUsageDescription[sdk=macosx*] = Programs you run in rootshell may access your photo library.
INFOPLIST_KEY_NSRemindersUsageDescription[sdk=macosx*] = Programs you run in rootshell may access your reminders.
INFOPLIST_KEY_NSRemindersFullAccessUsageDescription[sdk=macosx*] = Programs you run in rootshell may read and modify your reminders.
INFOPLIST_KEY_NSSpeechRecognitionUsageDescription[sdk=macosx*] = Programs you run in rootshell may use speech recognition.
INFOPLIST_KEY_NSSystemAdministrationUsageDescription[sdk=macosx*] = Programs you run in rootshell may request permission to change system configuration.

// Include rootshell-helper.app (no exclusions)
EXCLUDED_SOURCE_FILE_NAMES =

// Swift conditional compilation flag
// Keep aligned with the pinned YubiKit fork release. Restoring Lightning requires
// a new package release plus UISupportedExternalAccessoryProtocols in Info.plist.
OTHER_SWIFT_FLAGS = $(inherited) -D STANDALONE -D DISABLE_MFI_LIGHTNING

// Sparkle is linked through the pinned Swift package on the Standalone target.
// Carbon is linked for the Visor's RegisterEventHotKey (HIToolbox.framework
// is bundled inside Carbon.framework; we forward-declare the C entry points
// in VisorCarbonShim.swift because the Carbon umbrella header is broken on
// recent Catalyst SDKs).
OTHER_LDFLAGS[sdk=macosx*] = $(inherited) -framework Carbon
