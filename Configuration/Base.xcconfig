// Base.xcconfig - Shared settings for all builds

// Optional bundled service credentials. Keep Secrets.xcconfig untracked.
// Public builds use these empty defaults, expose PAT authentication only,
// and fall back to DNS for IP geolocation.
ROOTSHELL_LINODE_OAUTH_CLIENT_ID =
ROOTSHELL_LINODE_OAUTH_CLIENT_SECRET =
ROOTSHELL_DIGITALOCEAN_OAUTH_CLIENT_ID =
ROOTSHELL_DIGITALOCEAN_OAUTH_CLIENT_SECRET =
ROOTSHELL_IPINFO_TOKEN_XOR =
ROOTSHELL_IPINFO_TOKEN_KEY =
#include? "Secrets.xcconfig"

// Development Team
DEVELOPMENT_TEAM = D97ZME3ET2

// Swift Settings
SWIFT_VERSION = 5.0
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor

// Deployment Targets
IPHONEOS_DEPLOYMENT_TARGET = 18.0
XROS_DEPLOYMENT_TARGET = 26.0

// Supported Platforms (includes Catalyst)
SUPPORTED_PLATFORMS = iphoneos iphonesimulator xros xrsimulator
SUPPORTS_MACCATALYST = YES

// Device Families (1=iPhone, 2=iPad, 7=Apple Vision)
TARGETED_DEVICE_FAMILY = 1,2,7

// Framework Search Paths
FRAMEWORK_SEARCH_PATHS = $(inherited) $(PROJECT_DIR)/Frameworks

// App Identity
PRODUCT_BUNDLE_IDENTIFIER = com.kk2.rootshell
INFOPLIST_FILE = rootshell/Info.plist

// Swift Bridging Header
SWIFT_OBJC_BRIDGING_HEADER = $(SRCROOT)/rootshell/rootshell-Bridging-Header.h

// Header Search Paths (for local C bridge headers)
HEADER_SEARCH_PATHS = $(inherited) $(SRCROOT)/rootshell/Features/Git

// Security Settings (common)
RUNTIME_EXCEPTION_ALLOW_UNSIGNED_EXECUTABLE_MEMORY = NO
RUNTIME_EXCEPTION_DISABLE_LIBRARY_VALIDATION = NO

// Code Signing (automatic by default, overridden per variant)
CODE_SIGN_STYLE = Automatic

// Link libresolv for DNS TXT queries (mtr AS number lookup).
//
// GhosttyKit statically links its own oniguruma, and so do jq_ios and bat_ios.
// GhosttyKit is linked ahead of them so Ghostty resolves its own copy, and the
// app's copy is kept unexported so nothing built with -undefined dynamic_lookup
// can flat-lookup into it and end up mixing the two builds.
OTHER_LDFLAGS = $(inherited) -lresolv -Wl,-unexported_symbol,_onig* -Wl,-unexported_symbol,_Onig*

// Exclude ios_system resource plists from Mac Catalyst (not needed)
EXCLUDED_SOURCE_FILE_NAMES[sdk=macosx*] = $(inherited) commandDictionary.plist extraCommandsDictionary.plist
