{
  "model": "opus",
  "permissions": {
    "allow": ["Bash(git:*)"]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "say done", "timeout": 5}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "./lint.sh"}
        ]
      }
    ]
  },
  "env": {"FOO": "<bar>&baz"}
}
